# ------------------------------------------------------------------
# IN-GRES AI - Docker / public deployment configuration
# ------------------------------------------------------------------
# Usage:  copy to .env, generate real secrets (see below), then
#         docker compose up --build
#
# Generate secrets (PowerShell):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#   python -c "import secrets; print(secrets.token_urlsafe(16))"   # passwords
#
# NOTE: the same .env is used for ${...} substitution AND passed to the
# backend container, so the values below must be production-quality.
# Never commit this file once secrets are filled in.

# Application
APP_NAME=IN-GRES AI
ENVIRONMENT=production
API_PREFIX=/api

# Database (match the postgres service in docker-compose.yml)
POSTGRES_USER=ingres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=ingres
DATABASE_URL=postgresql+psycopg://ingres:CHANGE_ME_DB_PASSWORD@postgres:5432/ingres

# Geometry: PostGIS is available in the Docker database
ENABLE_GEOMETRY=true
# Docker image creates the schema via app.database.local_init on boot
AUTO_CREATE_SCHEMA=true

# JWT authentication - MUST be a long random value
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - the frontend is served by nginx on the same origin, so requests are
# same-origin and CORS is not required; keep the list for any separate origins
CORS_ORIGINS=https://your-app.example.com,https://*.trycloudflare.com

# Redis (compose overrides the host)
REDIS_URL=redis://redis:6379/0

# AI / LLM - leave disabled unless you proxy an OpenAI-compatible endpoint
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:14b
# Groq example: LLM_PROVIDER=groq + LLM_API_KEY=gsk_... (+ optional
# LLM_SEARCH_MODEL=openai/gpt-oss-20b for cheaper web answers).
# Do not use groq/compound (decommissioned 2026-09-21).
LLM_SEARCH_MODEL=
LLM_TIMEOUT_SECONDS=45
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SECONDS=8

# RAG knowledge base
KNOWLEDGE_DIR=knowledge/documents

# Voice / telephony - use mock unless you configure a provider
TELEPHONY_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VOICE_RECORDING_ENABLED=false

# Default demo accounts - CHANGE these before exposing publicly
SEED_ADMIN_EMAIL=admin@ingres.in
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_USER_EMAIL=user@ingres.in
SEED_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

# Demo dataset seeding
#   national = full all-India synthetic set (~517k villages; first boot ~3-5 min)
#   demo     = small 2-state sample (fast first boot)
#   none     = skip demo data (bring your own CSV via the imports page)
SEED_DATASET=demo
SEED_VILLAGES_PER_DISTRICT=0

# Real CGWB/IMD data (states/*.csv): set SEED_REAL_DATA=true to load on first
# boot, and REAL_DATA_AUTO_REFRESH=true to re-import changed CSVs on every boot.
SEED_REAL_DATA=false
REAL_DATA_AUTO_REFRESH=false
STATES_DATA_DIR=states

# Live government data: NWDP CGWB telemetry (no key) at boot + periodically,
# plus IMD rainfall when IMD_API_KEY is set.
LIVE_DATA_ENABLED=false
LIVE_SYNC_INTERVAL_MINUTES=360
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
LIVE_STATION_MATCH_RADIUS_KM=15

# Web Push (PWA notifications) - requires HTTPS; keys auto-generated on boot
WEB_PUSH_ENABLED=false
WEB_PUSH_EMAIL=admin@ingres.in
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
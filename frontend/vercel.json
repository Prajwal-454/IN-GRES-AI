{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo prebuilt-locally",
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ingres-ai-backend-70hy.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

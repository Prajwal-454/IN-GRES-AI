# ------------------------------------------------------------------
# IN-GRES AI - Environment configuration (copy to .env and edit)
# ------------------------------------------------------------------

# Application
APP_NAME=IN-GRES AI
ENVIRONMENT=development
API_PREFIX=/api

# Database (values must match the postgres service in docker-compose.yml)
#   SQLite (local dev):  DATABASE_URL=sqlite:///dev.db
#   PostGIS (Docker):    DATABASE_URL=postgresql+psycopg://ingres:ingres@postgres:5432/ingres
POSTGRES_USER=ingres
POSTGRES_PASSWORD=ingres
POSTGRES_DB=ingres
DATABASE_URL=postgresql+psycopg://ingres:ingres@localhost:5432/ingres

# Geometry: enable only with PostGIS/SpatiaLite. Keep false for SQLite dev.
ENABLE_GEOMETRY=true
# Auto-create schema on startup (fast dev). Use alembic migrations in production.
AUTO_CREATE_SCHEMA=false

# JWT authentication (change in production!)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# AI / LLM — any OpenAI-compatible endpoint. Pick a provider preset;
# LLM_BASE_URL / LLM_MODEL / LLM_API_KEY override the preset if set.
# ------------------------------------------------------------------
LLM_ENABLED=false
# ollama (local, no key)  -> qwen2.5:3b          http://localhost:11434/v1
# groq  (fast cloud, key) -> openai/gpt-oss-120b (with browser_search for web)
# openai                  -> gpt-4o-mini
# gemini                  -> gemini-2.0-flash
# mistral                 -> mistral-small-latest
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Search-native model for web answers (Groq: openai/gpt-oss-120b with
# browser_search; blank = provider default; other providers = ddgs fallback).
# groq/compound was decommissioned 2026-09-21 — do not use it.
LLM_SEARCH_MODEL=
LLM_TIMEOUT_SECONDS=90
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SECONDS=8

# ------------------------------------------------------------------
# RAG knowledge base
# ------------------------------------------------------------------
KNOWLEDGE_DIR=knowledge/documents

# ------------------------------------------------------------------
# Voice / telephony
# ------------------------------------------------------------------
# Provider: twilio | exotel | plivo | mock (mock = local dev simulator)
TELEPHONY_PROVIDER=mock

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exotel (India-focused)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Public HTTPS base URL where the backend is reachable (for webhooks/media).
# e.g. https://your-app.example.com  (Twilio/Exotel/Plivo require this)
VOICE_PUBLIC_URL=

# Speech-to-text / text-to-speech
#   STT: mock (dev) | vosk (FREE, local, offline, en/te/hi) | whisper (FREE, local, needs model download)
#   TTS: mock (dev) | edge  (FREE Microsoft neural voices, no API key)
STT_PROVIDER=vosk
STT_API_KEY=
STT_WHISPER_MODEL=base
STT_VOSK_MODEL_DIR=voice_models
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_EDGE_VOICE=

# Call recording: OFF by default. Enable only with a consent + retention policy.
VOICE_RECORDING_ENABLED=false

# Admin-configurable greeting and silence handling
VOICE_GREETING=Namaste. Welcome to IN-GRES AI, your groundwater information assistant. You can ask your question in English, Telugu, or Hindi.
VOICE_SILENCE_TIMEOUT_SECONDS=8
VOICE_MAX_SILENCE_PROMPTS=2

# ------------------------------------------------------------------
# Default demo accounts (dev only) - CHANGE before sharing/public deploy.
# Never commit a real .env with production passwords.
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ingres.in
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_USER_EMAIL=user@ingres.in
SEED_USER_PASSWORD=CHANGE_ME_USER_PASSWORD

# ------------------------------------------------------------------
# Demo dataset seeding
# ------------------------------------------------------------------
# "national" = all 36 states/UTs + real districts + generated villages
#              (default ~517k villages; fast, ~3 min on SQLite, one-time)
# "demo"     = small 2-state sample (used by the test suite)
# "none"     = skip groundwater demo data
SEED_DATASET=national
# 0 = auto-distribute villages to reach the national target; set a positive
# number to force the same village count per district (faster for dev).
SEED_VILLAGES_PER_DISTRICT=0

# ------------------------------------------------------------------
# Real CGWB/IMD data (states/*.csv)
# ------------------------------------------------------------------
# When true, `local_init` also loads the station-level real-data CSVs under
# STATES_DATA_DIR (idempotent). Real rows are labelled non-demo and are served
# in preference to the synthetic set for any scope that contains them.
SEED_REAL_DATA=false
# When true, the app refreshes the real dataset at every boot: CSVs are
# fingerprinted (sha256) and only states whose files changed are re-imported
# in place, so live data stays current automatically. `python -m
# app.ingres.real_import --refresh` and the admin /import-real?refresh=true
# endpoint do the same on demand.
REAL_DATA_AUTO_REFRESH=false
# Directory of <state_name>.csv files from the PDF-extraction pipeline.
STATES_DATA_DIR=states

# ------------------------------------------------------------------
# Live government data (NWDP CGWB telemetry + IMD rainfall)
# ------------------------------------------------------------------
# When true, the app pulls fresh groundwater levels from the CGWB telemetry
# dataset served by the National Water Data Portal (open API, no key) at boot
# and then periodically (LIVE_SYNC_INTERVAL_MINUTES), on top of the CSV
# baseline. Also triggers the background sync loop.
LIVE_DATA_ENABLED=false
LIVE_SYNC_INTERVAL_MINUTES=360
# IMD district rainfall API (https://api.imd.gov.in/api/v1). Requires free
# registration + IP whitelisting; leave empty to skip IMD rainfall.
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
# Max distance (km) to match a live telemetry station to a village.
LIVE_STATION_MATCH_RADIUS_KM=15

# ------------------------------------------------------------------
# Alerts / notifications (email)
# ------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ingres.in
SMTP_USE_TLS=true

# ------------------------------------------------------------------
# Scheduled reports / digests (Phase 24)
# ------------------------------------------------------------------
# When true, a background loop processes due report schedules every
# SCHEDULED_REPORTS_CHECK_MINUTES: the assessment PDF is rendered and stored
# under DATA_DIR/SCHEDULED_REPORTS_DIR and emailed to recipients when SMTP is
# configured. Users manage schedules on Reports -> Scheduled reports.
SCHEDULED_REPORTS_ENABLED=false
SCHEDULED_REPORTS_CHECK_MINUTES=60
SCHEDULED_REPORTS_DIR=scheduled_reports

# ------------------------------------------------------------------
# Data-quality anomaly scanning (Phase 24)
# ------------------------------------------------------------------
# Run the anomaly scan once at boot (also runnable on demand from
# Admin -> Data Quality). QUALITY_MAX_FLAGS_PER_SCAN caps how many new flags
# a single scan can create.
QUALITY_SCAN_ON_BOOT=false
QUALITY_MAX_FLAGS_PER_SCAN=500

# ------------------------------------------------------------------
# Web Push (PWA notifications)
# ------------------------------------------------------------------
# Requires HTTPS + a VAPID key pair. When left empty the keys are generated on
# first boot and stored under data/vapid-keys.json (keep that file safe).
# Public key should be a base64url-encoded 65-byte uncompressed P-256 point.
WEB_PUSH_ENABLED=false
WEB_PUSH_EMAIL=admin@ingres.in
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=